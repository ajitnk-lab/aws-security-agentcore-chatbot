{
  "openapi": "3.0.0",
  "info": {
    "title": "AWS Security Tools API",
    "version": "1.0.0",
    "description": "API for AWS security analysis tools"
  },
  "paths": {
    "/security/status": {
      "get": {
        "summary": "Get security service status",
        "operationId": "get_security_status",
        "description": "Check the status of AWS security services like GuardDuty, Security Hub, Inspector",
        "parameters": [
          {
            "name": "region",
            "in": "query",
            "description": "AWS region to check",
            "schema": {
              "type": "string",
              "default": "us-east-1"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Security service status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "guardduty": {"type": "string"},
                    "security_hub": {"type": "string"},
                    "inspector": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/security/findings": {
      "get": {
        "summary": "Get security findings",
        "operationId": "get_security_findings",
        "description": "Retrieve security findings from various AWS security services",
        "parameters": [
          {
            "name": "service",
            "in": "query",
            "description": "Security service to query",
            "schema": {
              "type": "string",
              "enum": ["guardduty", "security-hub", "inspector"]
            }
          },
          {
            "name": "severity",
            "in": "query",
            "description": "Minimum severity level",
            "schema": {
              "type": "string",
              "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Security findings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "findings": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {"type": "string"},
                          "title": {"type": "string"},
                          "severity": {"type": "string"},
                          "description": {"type": "string"}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
