{
  "name": "aws-security-agentcore-chatbot",
  "version": "1.0.0",
  "description": "Intelligent AWS security chatbot using Amazon Bedrock AgentCore",
  "main": "infrastructure/bin/app.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "deploy": "npm run build && cdk deploy --all --require-approval never",
    "deploy:dev": "npm run build && cdk deploy --all --context environment=development --require-approval never",
    "deploy:staging": "npm run build && cdk deploy --all --context environment=staging --require-approval never", 
    "deploy:prod": "npm run build && cdk deploy --all --context environment=production --require-approval never",
    "deploy:account": "npm run build && cdk deploy --all --context account=$AWS_ACCOUNT_ID --require-approval never",
    "destroy": "cdk destroy --all --force",
    "destroy:dev": "cdk destroy --all --context environment=development --force",
    "destroy:staging": "cdk destroy --all --context environment=staging --force",
    "destroy:prod": "cdk destroy --all --context environment=production --force",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "bootstrap": "cdk bootstrap",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "setup": "npm install && pip install -r requirements.txt",
    "test:mcp": "cd src/mcp-server && python -m pytest tests/",
    "test:integration": "cd tests && python -m pytest integration/",
    "docs": "typedoc --out docs/api src/"
  },
  "keywords": [
    "aws",
    "security",
    "bedrock",
    "agentcore",
    "mcp",
    "chatbot",
    "ai",
    "claude"
  ],
  "author": "AWS Security Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "aws-cdk": "^2.100.0",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.100.0",
    "constructs": "^10.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ajitnk-lab/aws-security-agentcore-chatbot.git"
  },
  "bugs": {
    "url": "https://github.com/ajitnk-lab/aws-security-agentcore-chatbot/issues"
  },
  "homepage": "https://github.com/ajitnk-lab/aws-security-agentcore-chatbot#readme"
}
